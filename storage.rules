rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@autoads.in' ||
        request.auth.token.email.matches('darshanct43@.*')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Drivers Document Uploads
    match /drivers/{userId}/{docType}/{fileName} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if (isAdmin() || isOwner(userId)) 
                   && request.resource.size < 10 * 1024 * 1024 // 10MB limit
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }
    
    // Campaign Media
    match /campaigns/{campaignId}/{type}/{fileName} {
      allow read: if true; // Publicly accessible for display
      allow write: if (isAdmin() || isSignedIn()) 
                   && request.resource.size < 100 * 1024 * 1024 // 100MB limit for high res
                   && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Support Tickets
    match /tickets/{ticketId}/{fileName} {
      allow read: if isSignedIn(); 
      allow write: if isSignedIn() 
                   && request.resource.size < 10 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Testing path
    match /test_connection.txt {
      allow read, write: if true;
    }
    match /test.txt {
      allow read, write: if true;
    }
  }
}
