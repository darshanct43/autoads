rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Drivers Document Uploads
    // Structure: drivers/{uid}/{filename}
    match /drivers/{userId}/{allPaths=**} {
      // Allow read/write only if the user is the owner
      // Or if they are an admin
      allow read, write: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == 'darshanct43@gmail.com' ||
        request.auth.token.email == 'admin@autoads.in'
      );
    }
    
    // Testing path (for the testUpload function and web tester)
    match /test_connection.txt {
      allow read, write: if true;
    }
    match /test.txt {
      allow read, write: if true;
    }
  }
}
