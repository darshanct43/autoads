<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">

  <title>{{ page_title }} | {{ shop.name }}</title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {{ 'autoads-cinematic.css' | asset_url | stylesheet_tag }}
  {{ 'autoads-style.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}

  <script>
    // High-performance AutoAds Edge CDN for 4K master slides & 350 motion frames
    window.AUTOADS_CDN_PATH = 'https://autoads.co.in/portfolio/assets/';
  </script>
</head>
<body class="autoads-theme-body template-{{ template.name }}">

<!-- FIXED CINEMATIC VIEWPORT STAGE -->
  <div class="cinematic-stage" aria-hidden="true">
    <canvas id="canvas-frames" class="canvas-layer"></canvas>
    <canvas id="canvas-particles" class="canvas-layer"></canvas>
    <div class="film-grain"></div>
    <div class="cinematic-vignette"></div>
    <div id="light-sweep" class="light-sweep"></div>
    <div class="letterbox top"></div>
    <div class="letterbox bottom"></div>
  </div>

  {% section 'header' %}

<!-- FIXED SIDE SCENE PROGRESS HUD -->
  <aside class="scene-hud" aria-label="Scene Progress">
    <div class="hud-label">
      <span id="hud-number">01 / 08</span>
      <span id="hud-title" class="hud-title">ADVERTISING IN INDIA</span>
    </div>
    <div class="hud-track">
      <div id="hud-progress" class="hud-progress-bar"></div>
    </div>
  </aside>

<!-- BOTTOM SCROLL INDICATOR -->
  <div id="scroll-cue" class="scroll-cue">
    <span class="scroll-cue-text">SCROLL TO EXPLORE CAMPAIGN STORY</span>
    <div class="scroll-cue-mouse">
      <div class="scroll-cue-wheel"></div>
    </div>
  </div>

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {{ 'particles.js' | asset_url | script_tag }}
  {{ 'cinematic-scroll.js' | asset_url | script_tag }}
  {{ 'app.js' | asset_url | script_tag }}
</body>
</html>
