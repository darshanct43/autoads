<div class="page-width page-content-container" style="padding: 120px 20px 80px; max-width: 1200px; margin: 0 auto; color: #fff;">
  <h1 class="main-page-title" style="font-family: 'Space Grotesk', sans-serif; font-size: 2.5rem; color: #FFCC00; margin-bottom: 24px;">{{ page.title | escape }}</h1>
  <div class="rte" style="line-height: 1.8; color: #D1D5DB;">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
