rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
      allow delete: if isAdmin();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'darshanct43@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Allow self-registration
      allow update: if isSignedIn() && (isOwner(driverId) || isAdmin());
      allow delete: if isAdmin();

      match /locations/{locId} {
        allow read, write: if isSignedIn() && (isOwner(driverId) || isAdmin());
      }
      match /logs/{logId} {
        allow read, write: if isSignedIn() && (isOwner(driverId) || isAdmin());
      }
    }

    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();

      match /media/{mediaId} {
        allow read, write: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      }
      match /payments/{payId} {
        allow read: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    match /driverAssignments/{assignmentId} {
      allow read: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /driverPayments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /withdrawRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }

    match /publicNotices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /driverLocations/{driverId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /deviceScreens/{driverId} {
      allow read: if isAdmin() || isOwner(driverId);
      allow write: if isOwner(driverId);
    }

    match /locationLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
    
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /incentiveOffers/{offerId} {
      allow read: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
