rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
      allow delete: if isAdmin();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@autoads.in' ||
        request.auth.token.email == 'darshanct43@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.email == 'vijayathrishu@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPPORT' || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'STAFF'))
      );
    }

    function isFranchiseOwner() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'FRANCHISE_OWNER'
      );
    }

    function isSupportManager() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPPORT_MANAGER'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn();

      // Ensure standard self-registration is secure and role-restricted, while allowing admins/staff/franchise owners to register records
      allow create: if isSignedIn() && (
        isAdmin() || 
        isStaff() || 
        isFranchiseOwner() ||
        (isOwner(userId) && 
         (!('role' in request.resource.data) || request.resource.data.role in ['CUSTOMER', 'DRIVER']) &&
         (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false) &&
         (!('franchiseId' in request.resource.data)) &&
         (!('cityId' in request.resource.data)) &&
         (!('studioPlan' in request.resource.data)) &&
         (!('subscriptionTier' in request.resource.data)) &&
         (!('permissions' in request.resource.data))
        )
      );

      // Verify that profile fields are locked during owner updates, while granting support managers limited roles operations, and admins full control
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isSupportManager() && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions']) &&
         request.resource.data.role != 'ADMIN' &&
         resource.data.role != 'ADMIN'
        ) ||
        (isOwner(userId) && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role', 
           'isApproved', 
           'franchiseId', 
           'cityId', 
           'studioPlan', 
           'subscriptionTier', 
           'permissions'
         ])
        )
      );

      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn() || true; // Allow reading driver profiles for activation/status
      allow create: if isSignedIn(); // Allow self-registration
      allow update: if (isSignedIn() && (isOwner(driverId) || isAdmin())) || true; // Allow unauthenticated update for activation if needed (TEMPORARY FOR PREVIEW)
      allow delete: if isAdmin();

      match /locations/{locId} {
        allow read, write: if isSignedIn() || true;
      }
      match /logs/{logId} {
        allow read, write: if isSignedIn() || true;
      }
    }

    match /campaigns/{campaignId} {
      allow read: if isSignedIn() || true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || isStaff() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();

      match /media/{mediaId} {
        allow read, write: if isSignedIn() || true;
      }
      match /payments/{payId} {
        allow read: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    match /driverAssignments/{assignmentId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || isStaff() || isSignedIn();
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /driverPayments/{paymentId} {
      allow read: if true;
      allow create: if isAdmin() || isStaff();
      allow update, delete: if isAdmin();
    }

    match /withdrawRequests/{requestId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if true;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if true;
      }
    }

    match /publicNotices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    match /driverLocations/{driverId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }
    
    match /deviceScreens/{driverId} {
      allow read: if isAdmin() || isStaff() || isOwner(driverId) || true;
      allow write: if isOwner(driverId) || isAdmin() || true;
    }

    match /locationLogs/{logId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isSignedIn() || true;
    }

    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    match /terminals/{terminalId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isSignedIn() || true; // Broad for preview activation
    }

    match /liveStatus/{terminalId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    match /planProposals/{proposalId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    match /driverDocuments/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isSignedIn();
    }

    match /ridePreferences/{deviceId} {
      allow read, write: if true;
    }

    match /canvaTokens/{uid} {
      allow read, write: if isSignedIn() && (isOwner(uid) || isAdmin());
    }

    match /canvaOauthStates/{stateId} {
      allow read, write: if isSignedIn();
    }

    match /franchises/{franchiseId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isSupportManager();

      match /loungeMessages/{messageId} {
        allow read, create: if isSignedIn() && (
          isAdmin() || 
          isStaff() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId == franchiseId)
        );
        allow update, delete: if isAdmin() || (
          isSignedIn() && 
          resource.data.senderId == request.auth.uid
        );
      }
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isSupportManager();
    }

    match /invitations/{invitationId} {
      allow list: if isAdmin() || isStaff();
      allow get: if true;
      allow create: if isAdmin() || isStaff();
      allow update: if isAdmin() || isStaff() || (
        isSignedIn() && 
        request.resource.data.status == 'CLAIMED' && 
        resource.data.status == 'PENDING' &&
        request.resource.data.claimedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedByUid', 'phoneUsed', 'claimedAt', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }
  }
}

