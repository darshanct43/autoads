rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
      allow delete: if isAdmin();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@autoads.in' ||
        request.auth.token.email == 'darshanct43@gmail.com' ||
        request.auth.token.email == 'dashanct43@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.email == 'vijayathrishu@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPPORT', 'SUPPORT_AGENT', 'SUPPORT_MANAGER', 'STAFF']))
      );
    }

    function isFranchiseOwner() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'FRANCHISE_OWNER'
      );
    }

    function isSupportManager() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPPORT_MANAGER'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isHQ() {
      return isSignedIn() && (
        isAdmin() ||
        isStaff() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['HQ_ADMIN', 'HQ_SUPPORT', 'SUPPORT', 'SUPPORT_AGENT', 'SUPPORT_MANAGER', 'SUPPORT_TEAM'])
      );
    }

    function isFranchiseStaffFor(franchiseId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId == franchiseId;
    }

    // --- Phase 4-10 Collections ---
    
    match /systemMetrics/{document=**} {
      allow read: if true;
      allow write: if isHQ() || isAdmin();
    }

    match /territories/{territoryId} {
      allow read: if isHQ() || (isSignedIn() && ((resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId) || resource.data.franchiseIds.hasAny([get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId])));
      allow write: if isAdmin();
    }
    
    match /territoryManagers/{managerId} {
      allow read: if isHQ() || (isSignedIn() && resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId);
      allow write: if isAdmin();
    }

    match /settlements/{settlementId} {
      allow read: if isHQ() || (isSignedIn() && resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId);
      allow write: if isAdmin();
    }

    match /settlementLogs/{logId} {
      allow read: if isAdmin() || isSupportManager() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['HQ_ADMIN', 'HQ_SUPPORT']);
      allow write: if isAdmin();
    }

    match /revenueDistributions/{distributionId} {
      allow read: if isHQ() || (isSignedIn() && resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId);
      allow write: if isAdmin();
    }

    match /territoryMetrics/{territoryId} {
      allow read: if isHQ() || (isSignedIn() && resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId);
      allow write: if false; // Only backend
    }

    match /franchiseMetrics/{franchiseId} {
      allow read: if isHQ() || isFranchiseStaffFor(franchiseId);
      allow write: if false; // Only backend
    }

    match /driverMetrics/{metricId} {
      allow read: if isHQ() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['FRANCHISE_OWNER', 'FRANCHISE_STAFF']);
      allow write: if false; // Only backend
    }

    match /campaignMetrics/{metricId} {
      allow read: if isHQ() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['FRANCHISE_OWNER', 'FRANCHISE_STAFF']);
      allow write: if false; // Only backend
    }

    match /deviceMetrics/{metricId} {
      allow read: if isHQ() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['FRANCHISE_OWNER', 'FRANCHISE_STAFF']);
      allow write: if false; // Only backend
    }

    match /fleetMetrics/{metricId} {
      allow read: if isHQ() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['FRANCHISE_OWNER', 'FRANCHISE_STAFF']);
      allow write: if false; // Only backend
    }

    match /deployments/{deploymentId} {
      allow read: if isHQ();
      allow write: if isHQ();
    }

    match /deviceHealth/{healthId} {
      allow read: if isHQ() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow write: if isHQ() || (isSignedIn() && (resource.data.driverId == request.auth.uid || request.resource.data.driverId == request.auth.uid));
    }

    match /deploymentAudits/{auditId} {
      allow read: if isHQ();
      allow write: if false; // only backend
    }

    match /campaignAnalytics/{campaignId} {
      allow read: if isHQ() || (isSignedIn() && resource.data.advertiserId == request.auth.uid);
      allow write: if false; // only backend
    }

    match /advertiserAnalytics/{advertiserId} {
      allow read: if isHQ() || (isSignedIn() && advertiserId == request.auth.uid);
      allow write: if false; // only backend
    }

    match /revenueAnalytics/{revenueId} {
      allow read: if isHQ();
      allow write: if false; // only backend
    }

    match /staffWhitelist/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isHQ();

      // Ensure standard self-registration is secure and role-restricted, while allowing admins/staff/franchise owners to register records
      allow create: if isSignedIn() && (
        isAdmin() || 
        isStaff() || 
        isFranchiseOwner() ||
        (isOwner(userId) && 
         (!('role' in request.resource.data) || request.resource.data.role in ['CUSTOMER', 'DRIVER']) &&
         (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false) &&
         (!('franchiseId' in request.resource.data)) &&
         (!('cityId' in request.resource.data)) &&
         (!('studioPlan' in request.resource.data)) &&
         (!('subscriptionTier' in request.resource.data)) &&
         (!('permissions' in request.resource.data))
        )
      );

      // Verify that profile fields are locked during owner updates, while granting support managers limited roles operations, and admins full control
      allow update: if isSignedIn() && (
        (isOwner(userId) && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role', 
           'isApproved', 
           'franchiseId', 
           'cityId', 
           'studioPlan', 
           'subscriptionTier', 
           'permissions'
         ])
        ) ||
        isAdmin() || 
        (isSupportManager() && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions']) &&
         request.resource.data.role != 'ADMIN' &&
         resource.data.role != 'ADMIN'
        )
      );

      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == driverId || request.auth.uid == request.resource.data.userId);
      allow update: if isHQ() || (isOwner(driverId) || isFranchiseStaffFor(resource.data.franchiseId));
      allow delete: if isAdmin();

      match /locations/{locId} {
        allow read, write: if isHQ() || isOwner(driverId);
      }
      match /logs/{logId} {
        allow read, write: if isHQ() || isOwner(driverId);
      }
    }

    match /campaigns/{campaignId} {
      allow read: if isHQ() || (isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'franchiseId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId) ||
        resource.data.customerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.advertiserId == request.auth.uid
      ));
      allow create: if isSignedIn() && (request.resource.data.createdBy == request.auth.uid || request.resource.data.customerId == request.auth.uid || request.resource.data.advertiserId == request.auth.uid);
      allow update: if isHQ() || (isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'franchiseId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId) ||
        resource.data.customerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.advertiserId == request.auth.uid
      ));
      allow delete: if isAdmin();

      match /media/{mediaId} {
        allow read, write: if isHQ() || (isSignedIn() && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid);
      }
      match /payments/{payId} {
        allow read: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin() || isSupportManager() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['HQ_ADMIN', 'HQ_SUPPORT'] ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['FRANCHISE_OWNER', 'FRANCHISE_STAFF'] && resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId)
      ));
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.performedBy;
      allow update, delete: if isAdmin();
    }
    
    match /terminals/{terminalId} {
      allow read: if true;
      allow write: if isHQ() || isFranchiseStaffFor(resource.data.franchiseId);
    }

    match /liveStatus/{terminalId} {
      allow read: if isHQ();
      allow write: if isHQ();
    }

    match /supportTickets/{ticketId} {
      allow read: if isHQ() || (isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.customerId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        resource.data.createdBy == request.auth.uid
      ));
      allow create: if isSignedIn();
      allow update: if isHQ() || (isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.customerId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        resource.data.createdBy == request.auth.uid
      ));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isHQ() || (isSignedIn() && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid || 
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.customerId == request.auth.uid || 
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.driverId == request.auth.uid || 
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.createdBy == request.auth.uid
        ));
        allow write: if isHQ() || (isSignedIn() && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid || 
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.customerId == request.auth.uid || 
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.driverId == request.auth.uid || 
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.createdBy == request.auth.uid
        ));
      }
    }

    match /planProposals/{proposalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['FRANCHISE_OWNER', 'HQ_SUPPORT']
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        isStaff() ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['FRANCHISE_OWNER', 'HQ_SUPPORT'])
      );
      allow delete: if isAdmin();
    }

    match /planEdits/{editId} {
      allow read, write: if isSignedIn() && isHQ();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isHQ(); // Lock to matches isHQ level
    }

    match /planConfigurations/{planId} {
      allow read: if true;
      allow write: if isHQ();
    }

    match /driverDocuments/{docId} {
      allow read: if isHQ() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow create: if isHQ() || (isSignedIn() && request.resource.data.driverId == request.auth.uid);
      allow update, delete: if isHQ() || (isSignedIn() && resource.data.driverId == request.auth.uid);
    }

    match /devices/{deviceId} {
      allow read: if true;
      allow write: if isHQ();
    }

    match /ridePreferences/{deviceId} {
      allow read, write: if true;
    }

    match /canvaTokens/{uid} {
      allow read, write: if isSignedIn() && (isOwner(uid) || isAdmin());
    }

    match /canvaOauthStates/{stateId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    match /franchises/{franchiseId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isSupportManager();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isSupportManager();
    }

    match /invitations/{invitationId} {
      allow list: if isAdmin() || isStaff();
      allow get: if true;
      allow create: if isAdmin() || isStaff();
      allow update: if isAdmin() || isStaff() || (
        isSignedIn() && 
        request.resource.data.status == 'CLAIMED' && 
        resource.data.status == 'PENDING' &&
        request.resource.data.claimedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedByUid', 'phoneUsed', 'claimedAt', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isHQ() || (isSignedIn() && resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId);
      allow write: if isHQ() || (isSignedIn() && resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId);
    }

    match /publicNotices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update: if isHQ();
      allow delete: if isAdmin() || isSupportManager();
    }

    match /driverAssignments/{assignmentId} {
      allow read: if isHQ() || (isSignedIn() && (
        resource.data.driverId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'franchiseId' in resource.data && 
         resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId)
      ));
      allow create: if isHQ() || isSignedIn();
      allow update: if isHQ() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /payments/{payId} {
      allow read: if isHQ() || (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'franchiseId' in resource.data && 
         resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId)
      ));
      allow create: if isSignedIn();
      allow update: if isHQ() || (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow delete: if isAdmin();
    }

    match /revenueLedger/{ledgerId} {
      allow read: if isHQ() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        'franchiseId' in resource.data && 
        resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId
      );
      allow create: if isSignedIn();
      allow update: if isHQ();
      allow delete: if isAdmin();
    }

    match /driverPayments/{paymentId} {
      allow read: if isHQ() || (isSignedIn() && (
        resource.data.driverId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'franchiseId' in resource.data && 
         resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId)
      ));
      allow create: if isHQ() || (isSignedIn() && request.resource.data.driverId == request.auth.uid);
      allow update: if isHQ() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /driverPayouts/{payoutId} {
      allow read: if isHQ() || (isSignedIn() && (
        resource.data.driverId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'franchiseId' in resource.data && 
         resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId)
      ));
      allow create: if isHQ();
      allow update: if isHQ();
      allow delete: if isAdmin();
    }

    match /withdrawRequests/{requestId} {
      allow read: if isHQ() || (isSignedIn() && (
        resource.data.driverId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'franchiseId' in resource.data && 
         resource.data.franchiseId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.franchiseId)
      ));
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow update: if isHQ() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow delete: if isAdmin() || isSupportManager();
    }

    // --- IoT Operations Control (Phase 4 Block) ---
    match /iotSims/{simId} {
      allow read, write: if isSignedIn();
    }
    match /iotRechargeHistory/{id} {
      allow read, write: if isSignedIn();
    }
    match /deviceTelemetry/{id} {
      allow read, write: if isSignedIn();
    }
    match /connectivityAlerts/{id} {
      allow read, write: if isSignedIn();
    }

    match /driverQuotes/{quoteId} {
      allow read: if isHQ() || isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.driverId == request.auth.uid);
      allow update: if isHQ() || isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvedAt', 'approvedBy', 'rejectedReason']));
      allow delete: if isAdmin() || isHQ();
    }
  }
}

