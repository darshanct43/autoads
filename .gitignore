# Ignore everything by default
*

# Allow directories
!src/
!src/**
!public/
!public/**

# Allow specific configuration and source files in root
!.gitignore
!.env.example
!package.json
!package-lock.json
!vite.config.ts
!tsconfig.json
!eslint.config.js
!index.html
!metadata.json
!server.ts
!firebase-applet-config.json
!firebase-blueprint.json
!firestore.rules
!storage.rules
!security_spec.md

# Explicitly ignore common mobile/junk folders if they leak 
android/
ios/
flutter/
.gradle/
.idea/
.vscode/

# Ignore standard build/temp folders even if unignored by wildcard
node_modules/
dist/
uploads/
build/
*.zip
*.log
*.kt
*.java
*.gradle
*.xml
*.properties
