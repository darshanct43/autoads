{
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/portfolio/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/canva/login",
      "destination": "/api/canva/login"
    },
    {
      "source": "/api/canva/login/",
      "destination": "/api/canva/login"
    },
    {
      "source": "/api/canva/login.",
      "destination": "/api/canva/login"
    },
    {
      "source": "/api/canva/callback",
      "destination": "/api/canva/callback"
    },
    {
      "source": "/api/canva/callback/",
      "destination": "/api/canva/callback"
    },
    {
      "source": "/api/canva/callback.",
      "destination": "/api/canva/callback"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/portfolio",
      "destination": "https://autoads-cinematic-portfolio.vercel.app/"
    },
    {
      "source": "/portfolio/",
      "destination": "https://autoads-cinematic-portfolio.vercel.app/"
    },
    {
      "source": "/portfolio/index.html",
      "destination": "https://autoads-cinematic-portfolio.vercel.app/"
    },
    {
      "source": "/portfolio/cities/:city.html",
      "destination": "https://autoads-cinematic-portfolio.vercel.app/cities/:city/"
    },
    {
      "source": "/portfolio/cities/:city",
      "destination": "https://autoads-cinematic-portfolio.vercel.app/cities/:city/"
    },
    {
      "source": "/portfolio/cities/:city/",
      "destination": "https://autoads-cinematic-portfolio.vercel.app/cities/:city/"
    },
    {
      "source": "/portfolio/:match*",
      "destination": "https://autoads-cinematic-portfolio.vercel.app/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}